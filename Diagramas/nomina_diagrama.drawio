    <!-- Reglas de negocio -->
    <mxCell id="reglas" value="Reglas de negocio&lt;br&gt;&lt;font color='#666666' size='1'&gt;salario = (basico/30) * dias&lt;br&gt;salud = salario * 0.04&lt;br&gt;pension = salario * 0.04&lt;br&gt;aux = (162000/30)*dias si basico &lt;= 2*SMMLV&lt;br&gt;neto = salario - salud - pension + aux&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f0a500;fontSize=10;arcSize=8;" vertex="1" parent="1">
